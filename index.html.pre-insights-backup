-placeholder-count=\"3\">\n            <button onclick=\"{{ ps.onPick }}\" style=\"flex:1; padding:10px; border:1px solid rgba(120,160,200,.16); border-radius:9px; background:rgba(12,19,32,.5); color:#cdd8ea; font-size:12.5px; cursor:pointer;\">{{ ps.label }}<\u002Fbutton>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n\n        <div style=\"font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.1em; text-transform:uppercase; color:#6b7a93; margin-bottom:6px;\">Filter by severity<\u002Fdiv>\n        <sc-for list=\"{{ sevToggles }}\" as=\"sv\" hint-placeholder-count=\"3\">\n          <div style=\"display:flex; align-items:center; justify-content:space-between; padding:11px 0; border-top:1px solid rgba(120,160,200,.08);\">\n            <span style=\"font-size:13.5px; color:#e6edf7;\">{{ sv.label }}<\u002Fspan>\n            <button onclick=\"{{ sv.onToggle }}\" style=\"position:relative; width:42px; height:24px; border:none; border-radius:13px; cursor:pointer; background:{{ sv.track }};\"><span style=\"position:absolute; top:3px; left:3px; width:18px; height:18px; border-radius:50%; background:#fff; transition:transform .15s; transform:translateX({{ sv.knob }});\"><\u002Fspan><\u002Fbutton>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n\n        <div style=\"display:flex; gap:10px; margin-top:24px; padding-top:18px; border-top:1px solid rgba(120,160,200,.12);\">\n          <a href=\"{{ adminHref }}\" style=\"flex:1; text-align:center; padding:11px; border:1px solid rgba(47,214,232,.3); border-radius:9px; background:rgba(13,32,38,.5); color:var(--accent); text-decoration:none; font-size:13px; font-weight:600;\">Sources &amp; admin \u2192<\u002Fa>\n          <button onclick=\"{{ onOpenTutorial }}\" style=\"flex:none; padding:11px 14px; border:1px solid rgba(120,160,200,.16); border-radius:9px; background:transparent; color:#cdd8ea; font-size:13px; cursor:pointer;\">Replay tour<\u002Fbutton>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <!-- TOAST -->\n  <sc-if value=\"{{ toast }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"position:fixed; bottom:24px; left:50%; transform:translateX(-50%); z-index:40; display:flex; align-items:center; gap:10px; padding:13px 20px; border:1px solid rgba(47,214,232,.3); border-radius:12px; background:#0d2026; color:#e6edf7; font-size:13.5px; animation:wmPop .2s ease both; box-shadow:0 12px 40px rgba(0,0,0,.5);\">\n      <span style=\"width:8px;height:8px;border-radius:50%;background:#27d796;box-shadow:0 0 8px #27d796;\"><\u002Fspan>{{ toast }}\n    <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <!-- LIVE TV -->\n  <sc-if value=\"{{ liveOpen }}\" hint-placeholder-val=\"{{ false }}\">\n    <div onclick=\"{{ onCloseLive }}\" style=\"position:fixed; inset:0; z-index:55; background:rgba(4,7,13,.8); display:flex; align-items:center; justify-content:center; animation:wmFade .15s ease both;\">\n      <div onclick=\"{{ stop }}\" style=\"width:940px; max-width:92%; height:580px; max-height:88%; display:flex; flex-direction:column; border:1px solid rgba(120,160,200,.18); border-radius:16px; background:#0b111c; overflow:hidden; box-shadow:0 24px 70px rgba(0,0,0,.6); animation:wmPop .2s ease both;\">\n        <div style=\"flex:none; display:flex; align-items:center; justify-content:space-between; padding:14px 18px; border-bottom:1px solid rgba(120,160,200,.12);\">\n          <div style=\"display:flex; align-items:center; gap:9px;\">\n            <span style=\"width:8px; height:8px; border-radius:50%; background:#ff3b5c; box-shadow:0 0 8px #ff3b5c;\"><\u002Fspan>\n            <span style=\"font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:15px; color:#f4f8ff;\">Live News<\u002Fspan>\n            <span style=\"font-size:12px; color:#7d8da6;\">\u00b7 {{ liveName }}<\u002Fspan>\n          <\u002Fdiv>\n          <button onclick=\"{{ onCloseLive }}\" style=\"width:32px; height:32px; border:1px solid rgba(120,160,200,.16); border-radius:8px; background:transparent; color:#cdd8ea; cursor:pointer; font-size:15px;\">\u2715<\u002Fbutton>\n        <\u002Fdiv>\n        <div style=\"flex:1; min-height:0; display:flex;\">\n          <div style=\"flex:none; width:208px; border-right:1px solid rgba(120,160,200,.12); padding:10px; overflow-y:auto;\">\n            <sc-for list=\"{{ channels }}\" as=\"ch\" hint-placeholder-count=\"6\">\n              <button onclick=\"{{ ch.onPick }}\" style=\"display:block; width:100%; text-align:left; padding:10px 11px; margin-bottom:3px; border:none; border-radius:9px; background:{{ ch.bg }}; cursor:pointer;\">\n                <div style=\"font-size:13px; font-weight:600; color:{{ ch.fg }};\">{{ ch.name }}<\u002Fdiv>\n                <div style=\"font-size:11px; color:#7d8da6; margin-top:2px;\">{{ ch.region }}<\u002Fdiv>\n              <\u002Fbutton>\n            <\u002Fsc-for>\n            <div style=\"margin-top:10px; padding:10px 11px; font-size:10.5px; line-height:1.5; color:#5a687f;\">Streams are the broadcasters' official 24\u002F7 YouTube live feeds.<\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"flex:1; min-width:0; background:#000; display:flex;\">\n            <iframe src=\"{{ liveSrc }}\" title=\"Live news\" allow=\"autoplay; encrypted-media; picture-in-picture\" allowfullscreen=\"\" style=\"width:100%; height:100%; border:0; display:block;\"><\u002Fiframe>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <!-- AI ASSISTANT -->\n  <sc-if value=\"{{ chatClosed }}\" hint-placeholder-val=\"{{ true }}\">\n    <button onclick=\"{{ onChatToggle }}\" style=\"position:fixed; right:22px; bottom:22px; z-index:45; display:flex; align-items:center; gap:9px; padding:13px 19px; border:none; border-radius:30px; background:var(--accent); color:#06121a; font-family:inherit; font-weight:600; font-size:14px; cursor:pointer; box-shadow:0 10px 30px rgba(47,214,232,.32);\">\u2726 Ask AI<\u002Fbutton>\n  <\u002Fsc-if>\n  <sc-if value=\"{{ chatOpen }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"position:fixed; right:22px; bottom:22px; z-index:46; width:380px; max-width:calc(100% - 44px); height:520px; max-height:calc(100% - 44px); display:flex; flex-direction:column; border:1px solid rgba(120,160,200,.18); border-radius:16px; background:#0b111c; box-shadow:0 24px 70px rgba(0,0,0,.6); overflow:hidden; animation:wmPop .2s ease both;\">\n      <div style=\"flex:none; display:flex; align-items:center; justify-content:space-between; padding:14px 16px; border-bottom:1px solid rgba(120,160,200,.12);\">\n        <div style=\"display:flex; align-items:center; gap:9px;\">\n          <span style=\"width:26px; height:26px; border-radius:8px; background:rgba(47,214,232,.14); display:flex; align-items:center; justify-content:center; color:var(--accent); font-size:13px;\">\u2726<\u002Fspan>\n          <div style=\"line-height:1.2;\">\n            <div style=\"font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:14px; color:#f4f8ff;\">Monitor assistant<\u002Fdiv>\n            <div style=\"font-size:10.5px; color:#7d8da6;\">Ask about anything you see<\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <button onclick=\"{{ onChatToggle }}\" style=\"width:30px; height:30px; border:1px solid rgba(120,160,200,.16); border-radius:8px; background:transparent; color:#cdd8ea; cursor:pointer; font-size:14px;\">\u2715<\u002Fbutton>\n      <\u002Fdiv>\n      <div style=\"flex:1; min-height:0; overflow-y:auto; padding:16px;\">\n        <sc-for list=\"{{ chatMsgs }}\" as=\"m\" hint-placeholder-count=\"1\">\n          <div style=\"display:flex; justify-content:{{ m.align }}; margin-bottom:10px;\">\n            <div style=\"max-width:82%; padding:10px 13px; border-radius:13px; background:{{ m.bg }}; color:{{ m.fg }}; font-size:13px; line-height:1.5;\">{{ m.text }}<\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n        <sc-if value=\"{{ chatBusy }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"display:flex; justify-content:flex-start; margin-bottom:10px;\"><div style=\"padding:10px 13px; border-radius:13px; background:rgba(120,160,200,.1); color:#9fadc4; font-size:13px;\">Thinking\u2026<\u002Fdiv><\u002Fdiv>\n        <\u002Fsc-if>\n        <sc-if value=\"{{ showSuggestions }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"display:flex; flex-wrap:wrap; gap:7px; margin-top:6px;\">\n            <sc-for list=\"{{ suggestions }}\" as=\"sg\" hint-placeholder-count=\"3\">\n              <button onclick=\"{{ sg.onPick }}\" style=\"padding:7px 12px; border:1px solid rgba(120,160,200,.2); border-radius:18px; background:transparent; color:#9fadc4; font-size:12px; cursor:pointer;\">{{ sg.text }}<\u002Fbutton>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n      <\u002Fdiv>\n      <div style=\"flex:none; display:flex; gap:8px; padding:12px; border-top:1px solid rgba(120,160,200,.12);\">\n        <input value=\"{{ chatInput }}\" oninput=\"{{ onChatInput }}\" onkeydown=\"{{ onChatKey }}\" placeholder=\"Ask a question\u2026\" style=\"flex:1; border:1px solid rgba(120,160,200,.18); border-radius:9px; background:rgba(12,19,32,.6); color:#e9eef6; padding:10px 12px; font-size:13px; outline:none;\">\n        <button onclick=\"{{ onChatSend }}\" style=\"padding:0 16px; border:none; border-radius:9px; background:var(--accent); color:#06121a; font-family:inherit; font-weight:600; font-size:13px; cursor:pointer;\">Send<\u002Fbutton>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <!-- TUTORIAL -->\n  <sc-if value=\"{{ tut }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"position:fixed; inset:0; z-index:60; background:rgba(4,7,13,.7); display:flex; align-items:center; justify-content:center; animation:wmFade .15s ease both;\">\n      <div style=\"width:440px; max-width:90%; padding:26px; border:1px solid rgba(120,160,200,.18); border-radius:16px; background:#0c1320; box-shadow:0 24px 70px rgba(0,0,0,.6); animation:wmPop .2s ease both;\">\n        <div style=\"font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.12em; color:var(--accent); margin-bottom:10px;\">STEP {{ tut.step }} \u002F {{ tut.total }}<\u002Fdiv>\n        <div style=\"font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:21px; color:#f4f8ff; margin-bottom:10px;\">{{ tut.title }}<\u002Fdiv>\n        <div style=\"font-size:14px; line-height:1.6; color:#cdd8ea;\">{{ tut.body }}<\u002Fdiv>\n        <div style=\"display:flex; align-items:center; justify-content:space-between; margin-top:24px;\">\n          <button onclick=\"{{ onTutDone }}\" style=\"border:none; background:transparent; color:#7d8da6; font-size:13px; cursor:pointer;\">Skip tour<\u002Fbutton>\n          <div style=\"display:flex; gap:8px;\">\n            <sc-if value=\"{{ tutBack }}\" hint-placeholder-val=\"{{ false }}\"><button onclick=\"{{ onTutPrev }}\" style=\"padding:9px 16px; border:1px solid rgba(120,160,200,.18); border-radius:9px; background:transparent; color:#cdd8ea; font-size:13px; cursor:pointer;\">Back<\u002Fbutton><\u002Fsc-if>\n            <button onclick=\"{{ onTutNext }}\" style=\"padding:9px 18px; border:none; border-radius:9px; background:var(--accent); color:#06121a; font-weight:600; font-size:13px; cursor:pointer;\">{{ tutNextLabel }}<\u002Fbutton>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n\n<\u002Fdiv>\n\n<\u002Fx-dc>\n<script type=\"text\u002Fx-dc\" data-dc-script=\"\">\nclass Component extends DCLogic {\n  constructor(props) {\n    super(props);\n    this.rootRef = React.createRef();\n    this.canvasRef = React.createRef();\n    this.tvCanvasRef = React.createRef();\n\n    const defaults = { defaultMap: 'globe', accent: '#2fd6e8', autoRotate: true, density: false, labels: true, font: 'system', surface: 'midnight', tutorialDone: false };\n    let saved = defaults;\n    try { saved = { ...defaults, ...JSON.pars