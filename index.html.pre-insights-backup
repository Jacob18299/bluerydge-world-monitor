u002Fbutton>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n\n        <div style=\"display:flex; align-items:center; justify-content:space-between; padding:14px 0; border-top:1px solid rgba(120,160,200,.1);\">\n          <div><div style=\"font-size:13.5px; color:#e6edf7;\">Auto-rotate the globe<\u002Fdiv><div style=\"font-size:11.5px; color:#7d8da6; margin-top:2px;\">Gently spins the 3D view<\u002Fdiv><\u002Fdiv>\n          <button onclick=\"{{ onToggleRotate }}\" style=\"position:relative; width:42px; height:24px; border:none; border-radius:13px; cursor:pointer; background:{{ ui.rotTrack }};\"><span style=\"position:absolute; top:3px; left:3px; width:18px; height:18px; border-radius:50%; background:#fff; transition:transform .15s; transform:translateX({{ ui.rotKnob }});\"><\u002Fspan><\u002Fbutton>\n        <\u002Fdiv>\n        <div style=\"display:flex; align-items:center; justify-content:space-between; padding:14px 0; border-top:1px solid rgba(120,160,200,.1);\">\n          <div><div style=\"font-size:13.5px; color:#e6edf7;\">Show map labels<\u002Fdiv><div style=\"font-size:11.5px; color:#7d8da6; margin-top:2px;\">Country, continent &amp; ocean names<\u002Fdiv><\u002Fdiv>\n          <button onclick=\"{{ onToggleLabels }}\" style=\"position:relative; width:42px; height:24px; border:none; border-radius:13px; cursor:pointer; background:{{ ui.labTrack }};\"><span style=\"position:absolute; top:3px; left:3px; width:18px; height:18px; border-radius:50%; background:#fff; transition:transform .15s; transform:translateX({{ ui.labKnob }});\"><\u002Fspan><\u002Fbutton>\n        <\u002Fdiv>\n        <div style=\"display:flex; align-items:center; justify-content:space-between; padding:14px 0; border-top:1px solid rgba(120,160,200,.1);\">\n          <div><div style=\"font-size:13.5px; color:#e6edf7;\">Compact list<\u002Fdiv><div style=\"font-size:11.5px; color:#7d8da6; margin-top:2px;\">Tighter rows in the feed<\u002Fdiv><\u002Fdiv>\n          <button onclick=\"{{ onToggleDen