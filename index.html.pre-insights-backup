0 28px 64px;\">\n\n      <section style=\"padding-top:42px;\">\n        <div style=\"display:flex; align-items:baseline; gap:12px; margin-bottom:18px;\">\n          <h2 style=\"margin:0; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:20px; color:#f4f8ff;\">Critical signals<\u002Fh2>\n          <span style=\"font-family:'JetBrains Mono',monospace; font-size:11px; color:#6b7a93;\">requiring attention<\u002Fspan>\n        <\u002Fdiv>\n        <div style=\"display:grid; grid-template-columns:repeat(auto-fill,minmax(270px,1fr)); gap:14px;\">\n          <sc-for list=\"{{ criticalCards }}\" as=\"c\" hint-placeholder-count=\"6\">\n            <div onclick=\"{{ c.onSelect }}\" style=\"cursor:pointer; padding:16px; border:1px solid rgba(120,160,200,.12); border-left:3px solid {{ c.color }}; border-radius:12px; background:rgba(12,19,32,.5);\">\n              <div style=\"display:flex; align-items:center; gap:8px; margin-bottom:8px;\">\n                <span style=\"font-family:'JetBrains Mono',monospace; font-size:9.5px; letter-spacing:.06em; color:{{ c.color }};\">CRITICAL<\u002Fspan>\n                <span style=\"font-size:10.5px; color:#6b7a93;\">{{ c.catLabel }}<\u002Fspan>\n                <span style=\"margin-left:auto; font-size:10.5px; color:#6b7a93;\">{{ c.time }}<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"font-size:14px; font-weight:600; line-height:1.35; color:#eef3fa;\">{{ c.title }}<\u002Fdiv>\n              <div style=\"display:flex; align-items:center; gap:6px; margin-top:9px; font-size:11.5px; color:#7d8da6;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);\"><\u002Fspan>{{ c.region }}<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fsection>\n\n      <section style=\"padding-top:42px;\">\n        <div style=\"display:flex; align-items:baseline; gap:12px; margin-bottom:18px;\">\n          <h2 style=\"margin:0; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:20px; color:#f4f8ff;\">Significant vulnerabilities<\u002Fh2>\n          <span style=\"font-family:'JetBrains Mono',monospace; font-size:11px; color:#6b7a93;\">last 14 days<\u002Fspan>\n        <\u002Fdiv>\n        <sc-for list=\"{{ vulns }}\" as=\"v\" hint-placeholder-count=\"5\">\n          <div style=\"margin-bottom:10px; border:1px solid rgba(120,160,200,.12); border-left:3px solid {{ v.color }}; border-radius:12px; background:rgba(12,19,32,.5); overflow:hidden;\">\n            <div onclick=\"{{ v.onToggle }}\" style=\"display:flex; align-items:center; gap:16px; padding:15px 18px; cursor:pointer;\">\n              <span style=\"font-family:'JetBrains Mono',monospace; font-size:9.5px; font-weight:500; padding:3px 8px; border-radius:5px; color:#08101a; background:{{ v.color }};\">{{ v.sev }}<\u002Fspan>\n              <div style=\"flex:1; min-width:0;\">\n                <div style=\"font-size:14px; font-weight:600; color:#eef3fa;\">{{ v.name }}<\u002Fdiv>\n                <div style=\"font-size:12px; color:#9fadc4; margin-top:3px;\">{{ v.impact }}<\u002Fdiv>\n              <\u002Fdiv>\n              <span style=\"font-family:'JetBrains Mono',monospace; font-size:11px; color:#7d8da6; white-space:nowrap;\">CVSS {{ v.cvss }}<\u002Fspan>\n              <span style=\"font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--accent); white-space:nowrap;\">{{ v.cve }}<\u002Fspan>\n              <span style=\"color:#6b7a93; font-size:12px; transition:transform .18s; transform:rotate({{ v.rot }}); display:inline-block;\">\u25be<\u002Fspan>\n            <\u002Fdiv>\n            <sc-if value=\"{{ v.open }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"padding:4px 18px 18px; animation:wmFade .2s ease both;\">\n                <div style=\"display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px;\">\n                  <span style=\"font-family:'JetBrains Mono',monospace; font-size:10px; padding:4px 9px; bor