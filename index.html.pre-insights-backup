               <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fsection>\n\n      <section style=\"padding-top:42px;\">\n        <div style=\"display:flex; align-items:baseline; gap:12px; margin-bottom:18px;\">\n          <h2 style=\"margin:0; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:20px; color:#f4f8ff;\">Markets &amp; economy<\u002Fh2>\n          <span style=\"font-family:'JetBrains Mono',monospace; font-size:11px; color:#6b7a93;\">indicative<\u002Fspan>\n        <\u002Fdiv>\n        <div style=\"display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:12px;\">\n          <sc-for list=\"{{ marketRows }}\" as=\"mk\" hint-placeholder-count=\"8\">\n            <div style=\"display:flex; align-items:center; justify-content:space-between; padding:15px 17px; border:1px solid rgba(120,160,200,.12); border-radius:12px; background:rgba(12,19,32,.5);\">\n              <span style=\"font-size:13px; color:#cdd8ea;\">{{ mk.name }}<\u002Fspan>\n              <span style=\"font-family:'JetBrains Mono',monospace; font-weight:600; font-size:14px; color:{{ mk.color }};\">{{ mk.val }}<\u002Fspan>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fsection>\n\n      <section style=\"padding-top:42px;\">\n        <div style=\"display:flex; align-items:baseline; gap:12px; margin-bottom:18px;\">\n          <h2 style=\"margin:0; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:20px; color:#f4f8ff;\">Live news<\u002Fh2>\n          <span style=\"font-family:'JetBrains Mono',monospace; font-size:11px; color:#6b7a93;\">tap to watch<\u002Fspan>\n        <\u002Fdiv>\n        <div style=\"display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:14px;\">\n          <sc-for list=\"{{ channelCards }}\" as=\"ch\" hint-placeholder-count=\"6\">\n            <div onclick=\"{{ ch.onPick }}\" style=\"cursor:pointer; padding:18px; border:1px solid rgba(120,160,200,.12); border-radius:12px; background:rgba(12,19,32,.5);\">\n              <div style=\"display:flex; align-items:center; gap:8px; margin-bottom:10px;\"><span style=\"width:7px;height:7px;border-radius:50%;background:#ff3b5c;box-shadow:0 0 8px #ff3b5c;\"><\u002Fspan><span style=\"font-family:'JetBrains Mono',monospace; font-size:9.5px; letter-spacing:.1em; color:#ffb3bf;\">LIVE<\u002Fspan><\u002Fdiv>\n              <div style=\"font-size:14.5px; font-weight:600; color:#eef3fa;\">{{ ch.name }}<\u002Fdiv>\n              <div style=\"font-size:11.5px; color:#7d8da6; margin-top:3px;\">{{ ch.region }}<\u002Fdiv>\n              <div style=\"font-size:12px; color:var(--accent); margin-top:11px;\">Watch live \u2192<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fsection>\n\n      <div style=\"margin-top:48px; padding-top:22px; border-top:1px solid rgba(120,160,200,.1); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;\">\n        <div style=\"font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:14px; letter-spacing:1px; color:#cdd8ea;\">BLUERYDGE <span style=\"color:var(--accent);\">WORLD MONITOR<\u002Fspan><\u002Fdiv>\n        <div style=\"font-size:11.5px; color:#6b7a93;\">Protect the Mission \u00b7 Secure Your Vision \u00b7 Indicative intelligence \u2014 sample data<\u002Fdiv>\n      <\u002Fdiv>\n\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <!-- PREFERENCES -->\n  <sc-if value=\"{{ prefsOpen }}\" hint-placeholder-val=\"{{ false }}\">\n    <div onclick=\"{{ onClosePrefs }}\" style=\"position:fixed; inset:0; z-index:30; background:rgba(4,7,13,.55); animation:wmFade .15s ease both; display:flex; justify-content:flex-end;\">\n      <div onclick=\"{{ stop }}\" style=\"width:368px; height:100%; background:#0b111c; border-left:1px solid rgba(120,160,200,.14); padding:22px; overflow-y:auto; animation:wm